<!DOCTYPE html>
<html lang="hu">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - InventoryManager</title>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body class="bg-light">
    <header>
        <nav class="navbar navbar-expand-lg navbar-dark bg-dark shadow-sm">
            <div class="container">
                <a class="navbar-brand fw-bold text-white d-flex align-items-center gap-2" asp-area="" asp-controller="Inventory" asp-action="Index">
                    <i class="bi bi-boxes fs-4 text-warning"></i>
                    <span>InventoryManager</span>
                </a>
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#mainNavbar" aria-controls="mainNavbar"
                        aria-expanded="false" aria-label="Navigáció váltása">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="collapse navbar-collapse" id="mainNavbar">
                    <ul class="navbar-nav me-auto mb-2 mb-lg-0">
                        <li class="nav-item">
                            <a class="nav-link" asp-controller="Inventory" asp-action="Index">
                                <i class="bi bi-speedometer2 me-1"></i>Készlet áttekintő
                            </a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" asp-controller="Products" asp-action="Index">
                                <i class="bi bi-tag me-1"></i>Termékek
                            </a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" asp-controller="Inventory" asp-action="Movements">
                                <i class="bi bi-clock-history me-1"></i>Készletmozgások
                            </a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" asp-controller="Reorders" asp-action="Index">
                                <i class="bi bi-cart-check me-1"></i>Utánrendelések
                            </a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" asp-controller="Notifications" asp-action="Index">
                                <i class="bi bi-envelope-check me-1"></i>Értesítések
                            </a>
                        </li>
                    </ul>

                    <div class="d-flex align-items-center gap-2">
                        @if (User.Identity?.IsAuthenticated == true)
                        {
                            @if (User.IsInRole("Raktaros"))
                            {
                                <a asp-controller="Inventory" asp-action="Receive" class="btn btn-success btn-sm d-flex align-items-center gap-1 shadow-sm">
                                    <i class="bi bi-arrow-down-circle-fill"></i>
                                    <span>Új beérkezés</span>
                                </a>
                                <a asp-controller="Inventory" asp-action="Issue" class="btn btn-outline-danger btn-sm d-flex align-items-center gap-1">
                                    <i class="bi bi-arrow-up-circle"></i>
                                    <span>Kiadás</span>
                                </a>
                            }

                            @if (User.IsInRole("Beszerzo"))
                            {
                                <a asp-controller="Products" asp-action="Create" class="btn btn-outline-primary btn-sm d-flex align-items-center gap-1">
                                    <i class="bi bi-plus-circle"></i>
                                    <span>Új termék</span>
                                </a>
                            }

                            <div class="dropdown ms-2">
                                <button class="btn btn-secondary btn-sm dropdown-toggle d-flex align-items-center gap-2" type="button" data-bs-toggle="dropdown">
                                    <i class="bi bi-person-circle"></i>
                                    <span>@(User.FindFirst("FullName")?.Value ?? User.Identity.Name)</span>
                                    @if (User.IsInRole("Raktaros"))
                                    {
                                        <span class="badge bg-success">Raktáros</span>
                                    }
                                    else if (User.IsInRole("Beszerzo"))
                                    {
                                        <span class="badge bg-info text-dark">Beszerző</span>
                                    }
                                </button>
                                <ul class="dropdown-menu dropdown-menu-end shadow">
                                    <li class="dropdown-item-text small text-muted">
                                        <i class="bi bi-envelope me-1"></i>kundavid16@gmail.com
                                    </li>
                                    <li><hr class="dropdown-divider"></li>
                                    <li class="dropdown-header">Szerepkör váltása / Demó</li>
                                    <li>
                                        <form asp-controller="Account" asp-action="QuickLogin" method="post" class="px-2 py-1">
                                            <input type="hidden" name="role" value="Raktaros" />
                                            <button type="submit" class="btn btn-sm btn-outline-success w-100 text-start">
                                                <i class="bi bi-box-seam me-1"></i> Váltás Raktárosra
                                            </button>
                                        </form>
                                    </li>
                                    <li>
                                        <form asp-controller="Account" asp-action="QuickLogin" method="post" class="px-2 py-1">
                                            <input type="hidden" name="role" value="Beszerzo" />
                                            <button type="submit" class="btn btn-sm btn-outline-primary w-100 text-start">
                                                <i class="bi bi-cart-check me-1"></i> Váltás Beszerzőre
                                            </button>
                                        </form>
                                    </li>
                                    <li><hr class="dropdown-divider"></li>
                                    <li>
                                        <form asp-controller="Account" asp-action="Logout" method="post" class="px-2">
                                            <button type="submit" class="btn btn-sm btn-danger w-100">
                                                <i class="bi bi-box-arrow-right me-1"></i> Kijelentkezés
                                            </button>
                                        </form>
                                    </li>
                                </ul>
                            </div>
                        }
                        else
                        {
                            <a asp-controller="Account" asp-action="Login" class="btn btn-primary btn-sm">
                                <i class="bi bi-box-arrow-in-right me-1"></i> Bejelentkezés
                            </a>
                        }
                    </div>
                </div>
            </div>
        </nav>
    </header>

    <div class="container my-4">
        @if (TempData["SuccessMessage"] != null)
        {
            <div class="alert alert-success alert-dismissible fade show shadow-sm" role="alert">
                <i class="bi bi-check-circle-fill me-2"></i>
                @TempData["SuccessMessage"]
                <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Bezárás"></button>
            </div>
        }

        <main role="main" class="pb-3">
            @RenderBody()
        </main>
    </div>

    <footer class="footer border-top py-3 text-muted bg-white text-center mt-auto">
        <div class="container">
            <small>&copy; @DateTime.UtcNow.Year - InventoryManager | Értesítések: <strong>kundavid16@gmail.com</strong> | Szabály: Készlet nem lehet negatív</small>
        </div>
    </footer>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
