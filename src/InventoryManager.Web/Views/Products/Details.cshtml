@model InventoryManager.Web.Models.Product
@{
    ViewData["Title"] = $"{Model.Name} - Részletek";
    int currentStock = ViewBag.CurrentStock ?? 0;
    bool isRaktaros = User.IsInRole("Raktaros");
    bool isBeszerzo = User.IsInRole("Beszerzo");
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <a asp-action="Index" class="btn btn-sm btn-outline-secondary mb-2">
            <i class="bi bi-arrow-left me-1"></i> Vissza a terméklistához
        </a>
        <h2 class="fw-bold mb-0">@Model.Name</h2>
        <span class="badge bg-light text-dark border font-monospace fs-6 mt-1">@Model.Sku</span>
    </div>
    <div class="d-flex gap-2">
        @if (isRaktaros)
        {
            <a asp-controller="Inventory" asp-action="Receive" asp-route-productId="@Model.Id" class="btn btn-success">
                <i class="bi bi-arrow-down-circle-fill me-1"></i> Új beérkezés
            </a>
            <a asp-controller="Inventory" asp-action="Issue" asp-route-productId="@Model.Id" class="btn btn-outline-danger">
                <i class="bi bi-arrow-up-circle me-1"></i> Kiadás
            </a>
        }
    </div>
</div>

<div class="row g-4 mb-4">
    <div class="col-md-7">
        <div class="card shadow-sm border-0 h-100">
            <div class="card-header bg-white py-3">
                <h5 class="card-title fw-bold mb-0">Termék Törzsadatok &amp; Szabályok</h5>
            </div>
            <div class="card-body">
                <dl class="row mb-0">
                    <dt class="col-sm-4 text-muted">Cikkszám (SKU):</dt>
                    <dd class="col-sm-8 font-monospace fw-bold">@Model.Sku</dd>

                    <dt class="col-sm-4 text-muted">Terméknév:</dt>
                    <dd class="col-sm-8 fw-semibold">@Model.Name</dd>

                    <dt class="col-sm-4 text-muted">Kategória:</dt>
                    <dd class="col-sm-8">
                        @if (!string.IsNullOrEmpty(Model.Category))
                        {
                            <span class="badge-category">@Model.Category</span>
                        }
                        else
                        {
                            <span class="text-muted">-</span>
                        }
                    </dd>

                    <dt class="col-sm-4 text-muted">Mértékegység:</dt>
                    <dd class="col-sm-8">@Model.Unit</dd>

                    <dt class="col-sm-4 text-muted">Egységár:</dt>
                    <dd class="col-sm-8 fw-bold text-dark">@Model.UnitPrice.ToString("N0") Ft</dd>

                    <dt class="col-sm-4 text-muted">Minimális készletküszöb:</dt>
                    <dd class="col-sm-8 fw-semibold">@Model.MinimumStockLevel @Model.Unit</dd>

                    <dt class="col-sm-4 text-muted">Automata utánrendelés:</dt>
                    <dd class="col-sm-8">
                        @if (Model.AutoReorderEnabled)
                        {
                            <span class="badge bg-success text-white px-2 py-1 shadow-sm">
                                <i class="bi bi-check-circle me-1"></i> Aktív (Tétel: +@Model.ReorderQuantity @Model.Unit)
                            </span>
                        }
                        else
                        {
                            <span class="badge bg-secondary text-white px-2 py-1">Kikapcsolva</span>
                        }
                    </dd>

                    <dt class="col-sm-4 text-muted">Beszállító:</dt>
                    <dd class="col-sm-8">@(Model.SupplierName ?? "-") @(!string.IsNullOrEmpty(Model.SupplierEmail) ? $"({Model.SupplierEmail})" : "")</dd>

                    <dt class="col-sm-4 text-muted">Leírás:</dt>
                    <dd class="col-sm-8">@(Model.Description ?? "-")</dd>

                    <dt class="col-sm-4 text-muted">Létrehozva:</dt>
                    <dd class="col-sm-8">@Model.CreatedAt.ToLocalTime().ToString("yyyy.MM.dd. HH:mm")</dd>
                </dl>
            </div>
        </div>
    </div>

    <div class="col-md-5">
        <div class="card shadow-sm border-0 h-100">
            <div class="card-header bg-white py-3">
                <h5 class="card-title fw-bold mb-0">Készlet Státusz</h5>
            </div>
            <div class="card-body d-flex flex-column justify-content-center text-center p-4">
                <div class="display-4 fw-bold @(currentStock <= 0 ? "text-danger" : (currentStock < Model.MinimumStockLevel ? "text-warning" : "text-success"))">
                    @currentStock <span class="fs-4 text-muted">@Model.Unit</span>
                </div>
                <div class="mt-2">
                    @if (currentStock <= 0)
                    {
                        <span class="badge bg-danger fs-6 px-3 py-2">
                            <i class="bi bi-x-circle me-1"></i> Elfogyott a raktárból
                        </span>
                    }
                    else if (currentStock < Model.MinimumStockLevel)
                    {
                        <span class="badge bg-warning text-dark fs-6 px-3 py-2">
                            <i class="bi bi-exclamation-triangle me-1"></i> Alacsony készlet (Utánrendelés javasolt)
                        </span>
                    }
                    else
                    {
                        <span class="badge bg-success fs-6 px-3 py-2">
                            <i class="bi bi-check-circle me-1"></i> Megfelelő készlet
                        </span>
                    }
                </div>
                <hr class="my-4" />
                <div class="text-muted small">
                    Raktári készlet összértéke:
                    <div class="fs-4 fw-bold text-dark mt-1">
                        @((currentStock * Model.UnitPrice).ToString("N0")) Ft
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Termékhez tartozó mozgástörténet -->
<div class="card shadow-sm border-0">
    <div class="card-header bg-white py-3 d-flex justify-content-between align-items-center">
        <h5 class="card-title fw-bold mb-0"><i class="bi bi-clock-history me-2"></i>Termék Mozgástörténete</h5>
        <span class="badge bg-secondary">@(Model.StockMovements?.Count ?? 0) esemény</span>
    </div>
    <div class="table-responsive">
        <table class="table table-hover align-middle mb-0">
            <thead class="table-light">
                <tr>
                    <th>Időpont</th>
                    <th class="text-center">Típus</th>
                    <th class="text-end">Mennyiség</th>
                    <th>Bizonylatszám</th>
                    <th>Megjegyzés</th>
                </tr>
            </thead>
            <tbody>
                @if (Model.StockMovements == null || !Model.StockMovements.Any())
                {
                    <tr>
                        <td colspan="5" class="text-center py-4 text-muted">
                            Ehhez a termékhez még nem történt készletmozgás.
                        </td>
                    </tr>
                }
                else
                {
                    @foreach (var m in Model.StockMovements.OrderByDescending(x => x.MovementDate))
                    {
                        <tr>
                            <td class="text-muted small font-monospace">@m.MovementDate.ToLocalTime().ToString("yyyy.MM.dd. HH:mm")</td>
                            <td class="text-center">
                                @if (m.Type == MovementType.Inbound)
                                {
                                    <span class="badge-inbound">
                                        <i class="bi bi-arrow-down-circle"></i> Beérkezés
                                    </span>
                                }
                                else if (m.Type == MovementType.Outbound)
                                {
                                    <span class="badge-outbound">
                                        <i class="bi bi-arrow-up-circle"></i> Kiadás
                                    </span>
                                }
                                else
                                {
                                    <span class="badge-adjustment">
                                        <i class="bi bi-arrow-left-right"></i> Korrekció
                                    </span>
                                }
                            </td>
                            <td class="text-end fw-bold @(m.Type == MovementType.Inbound ? "text-success" : (m.Type == MovementType.Outbound ? "text-danger" : ""))">
                                @(m.Type == MovementType.Inbound ? "+" : "-")@m.Quantity @Model.Unit
                            </td>
                            <td class="font-monospace small">@(m.ReferenceNumber ?? "-")</td>
                            <td class="text-muted small">@(m.Notes ?? "-")</td>
                        </tr>
                    }
                }
            </tbody>
        </table>
    </div>
</div>
