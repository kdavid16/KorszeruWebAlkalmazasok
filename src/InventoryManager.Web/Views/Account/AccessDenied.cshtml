@{
    ViewData["Title"] = "Hozzáférés Megtagadva";
}

<div class="row justify-content-center mt-5">
    <div class="col-md-6 text-center">
        <div class="card shadow-sm border-0 p-5">
            <div class="text-danger mb-3">
                <i class="bi bi-shield-slash fs-1"></i>
            </div>
            <h3 class="fw-bold text-danger">Hozzáférés Megtagadva</h3>
            <p class="text-muted mt-2">
                A jelenlegi szerepköröddel (<strong>@(User.FindFirst(System.Security.Claims.ClaimTypes.Role)?.Value ?? "Nincs")</strong>) nem rendelkezel jogosultsággal ennek a funkciónak az eléréséhez.
            </p>
            <div class="d-flex justify-content-center gap-2 mt-4">
                <a asp-controller="Inventory" asp-action="Index" class="btn btn-outline-secondary">
                    <i class="bi bi-arrow-left me-1"></i> Vissza a készlethez
                </a>
                <form asp-controller="Account" asp-action="Logout" method="post" class="d-inline">
                    <button type="submit" class="btn btn-primary">
                        <i class="bi bi-arrow-repeat me-1"></i> Bejelentkezés másik szerepkörrel
                    </button>
                </form>
            </div>
        </div>
    </div>
</div>
