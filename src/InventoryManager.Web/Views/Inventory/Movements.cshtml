@model IReadOnlyList<InventoryManager.Web.Models.StockMovement>
@{
    ViewData["Title"] = "Készletmozgások Naplója";
    var selectedProductId = ViewBag.SelectedProductId as int?;
    var products = ViewBag.Products as IEnumerable<SelectListItem>;
    bool isRaktaros = User.IsInRole("Raktaros");
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h2 class="fw-bold mb-1"><i class="bi bi-clock-history text-primary me-2"></i>Készletmozgások Naplója</h2>
        <p class="text-muted mb-0">Az összes beérkezés, kiadás és korrekció teljes audit naplója.</p>
    </div>
    @if (isRaktaros)
    {
        <div class="d-flex gap-2">
            <a asp-action="Receive" class="btn btn-success">
                <i class="bi bi-arrow-down-circle-fill me-1"></i> Új beérkezés
            </a>
            <a asp-action="Issue" class="btn btn-outline-danger">
                <i class="bi bi-arrow-up-circle me-1"></i> Kiadás
            </a>
        </div>
    }
</div>

<!-- Termék szűrő -->
<div class="card shadow-sm border-0 mb-4">
    <div class="card-body py-3">
        <form asp-action="Movements" method="get" class="row g-3 align-items-center">
            <div class="col-auto">
                <label class="col-form-label fw-semibold"><i class="bi bi-funnel me-1"></i>Szűrés termékre:</label>
            </div>
            <div class="col-md-5">
                <select name="productId" class="form-select" onchange="this.form.submit()">
                    <option value="">-- Minden termék mozgása --</option>
                    @if (products != null)
                    {
                        foreach (var prod in products)
                        {
                            <option value="@prod.Value" selected="@prod.Selected">@prod.Text</option>
                        }
                    }
                </select>
            </div>
            @if (selectedProductId.HasValue)
            {
                <div class="col-auto">
                    <a asp-action="Movements" class="btn btn-outline-secondary">
                        <i class="bi bi-x-circle me-1"></i> Szűrő törlése
                    </a>
                </div>
            }
        </form>
    </div>
</div>

<!-- Mozgás táblázat -->
<div class="card shadow-sm border-0">
    <div class="table-responsive">
        <table class="table table-hover align-middle mb-0">
            <thead class="table-light">
                <tr>
                    <th>Időpont</th>
                    <th>Termék</th>
                    <th class="text-center">Típus</th>
                    <th class="text-end">Mennyiség</th>
                    <th>Bizonylat / Szállítólevél</th>
                    <th>Megjegyzés</th>
                </tr>
            </thead>
            <tbody>
                @if (Model.Count == 0)
                {
                    <tr>
                        <td colspan="6" class="text-center py-4 text-muted">
                            <i class="bi bi-journal-x fs-2 d-block mb-2"></i>
                            Nem található készletmozgás a megadott feltételekkel.
                        </td>
                    </tr>
                }
                else
                {
                    @foreach (var m in Model)
                    {
                        <tr>
                            <td class="text-muted small font-monospace">
                                @m.MovementDate.ToLocalTime().ToString("yyyy.MM.dd. HH:mm")
                            </td>
                            <td>
                                <div>
                                    <span class="badge bg-light text-dark border font-monospace me-1">@(m.Product?.Sku ?? "-")</span>
                                    <a asp-controller="Products" asp-action="Details" asp-route-id="@m.ProductId" class="fw-semibold text-decoration-none">
                                        @(m.Product?.Name ?? "Ismeretlen termék")
                                    </a>
                                </div>
                            </td>
                            <td class="text-center">
                                @if (m.Type == MovementType.Inbound)
                                {
                                    <span class="badge-inbound">
                                        <i class="bi bi-arrow-down-circle"></i> Beérkezés
                                    </span>
                                }
                                else if (m.Type == MovementType.Outbound)
                                {
                                    <span class="badge-outbound">
                                        <i class="bi bi-arrow-up-circle"></i> Kiadás
                                    </span>
                                }
                                else
                                {
                                    <span class="badge-adjustment">
                                        <i class="bi bi-arrow-left-right"></i> Korrekció
                                    </span>
                                }
                            </td>
                            <td class="text-end fw-bold fs-6 @(m.Type == MovementType.Inbound ? "text-success" : (m.Type == MovementType.Outbound ? "text-danger" : ""))">
                                @(m.Type == MovementType.Inbound ? "+" : (m.Type == MovementType.Outbound ? "-" : ""))@m.Quantity @(m.Product?.Unit ?? "db")
                            </td>
                            <td>
                                @if (!string.IsNullOrEmpty(m.ReferenceNumber))
                                {
                                    <span class="badge bg-light text-secondary border font-monospace">@m.ReferenceNumber</span>
                                }
                                else
                                {
                                    <span class="text-muted small">-</span>
                                }
                            </td>
                            <td class="text-muted small">
                                @(m.Notes ?? "-")
                            </td>
                        </tr>
                    }
                }
            </tbody>
        </table>
    </div>
</div>
